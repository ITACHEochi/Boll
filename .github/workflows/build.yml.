name: Build Kivy APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Install system deps
      run: |
        sudo apt update
        sudo apt install -y \
        python3-pip \
        git \
        zip \
        unzip \
        openjdk-17-jdk

    - name: Install buildozer
      run: |
        pip install --upgrade pip
        pip install cython buildozer

    - name: Init buildozer
      run: |
        buildozer init || true

    - name: Build APK
      run: |
        buildozer android debug
